# 复制为 .env 并填入真实值（docker compose 读取，勿提交 .env）
#
# 上线前必须：
#   AUTH_REQUIRED=true
#   JWT_SECRET>=32 字符随机值（openssl rand -hex 32）
#   CORS_ORIGINS=具体前端域名（不能是 *）
#   DEMO_LOGIN_ENABLED=false（生产关闭一键演示登录）
#   DEMO_USER_PASSWORD=强口令
#   若开启 REQUIRE_EMAIL_VERIFICATION=true，必须同时配好 EMAIL_*，否则注册不可用

# ── LLM ──
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com
LLM_FALLBACK_MODEL=deepseek-v4-flash
LLM_DAILY_LIMIT=1000

# ── 认证 ──
JWT_SECRET=your-jwt-secret-here-at-least-32-chars
AUTH_REQUIRED=true
ALLOW_SELF_REGISTER=false
DEMO_LOGIN_ENABLED=false
CORS_ORIGINS=http://localhost:3000
DEMO_USER_EMAIL=admin@example.com
DEMO_USER_PASSWORD=change-me-now

# ── 邮箱验证码（注册）──
# true 时注册必须携带邮箱验证码；开启前必须先配好下面三项，
# 否则用户既收不到码也注册不了（send-code 会返回 503）。
REQUIRE_EMAIL_VERIFICATION=true
# 国内 SMTP 示例（QQ 邮箱）：
#   EMAIL_PASSWORD 填「SMTP 授权码」，不是邮箱登录密码
#   QQ 邮箱 → 设置 → 账户 → POP3/IMAP/SMTP服务 → 开启并生成授权码
#   网易 163: EMAIL_SMTP_HOST=smtp.163.com   （同样用客户端授权码）
#   阿里云:    EMAIL_SMTP_HOST=smtp.aliyun.com
EMAIL_SENDER=your-account@qq.com
EMAIL_PASSWORD=your-smtp-auth-code
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
# 验证码有效期按用途（秒）：注册 15min / 登录与发信 10min（企划书 §3.2）
VERIFY_CODE_TTL_REGISTER=900
VERIFY_CODE_TTL_LOGIN=600
# 重发冷却（秒）/ 单码最大试错次数
VERIFY_RESEND_COOLDOWN=60
VERIFY_MAX_ATTEMPTS=5
# 发送限流（滑动窗口）：每邮箱 15 分钟 ≤5 次；每 IP 可配
VERIFY_SEND_WINDOW_SECONDS=900
VERIFY_SEND_LIMIT_PER_EMAIL=5
VERIFY_SEND_LIMIT_PER_IP=20
# 试错超限后的冷却窗口（独立 attempts 计数键 TTL）
VERIFY_ATTEMPT_WINDOW_SECONDS=900
