# 复制为 .env 并填入真实值（docker compose 读取，勿提交 .env）
#
# ⚠️ 安全：仓库曾泄露一枚真实 DeepSeek key（sk-91d6…），已全仓脱敏。
#    请到 DeepSeek 控制台「API Keys」重新生成一枚新 key 填入 LLM_API_KEY，
#    旧的 key 已在泄露后失效，切勿再次把真实 key 写入会提交的文件。

# ── LLM ──
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com
LLM_FALLBACK_MODEL=deepseek-v4-flash
LLM_DAILY_LIMIT=1000

# ── 认证（上线前必须开启 AUTH_REQUIRED=true）──
# AUTH_REQUIRED=true 时后端会强制校验：
#   · JWT_SECRET 至少 32 字符随机值（生成：openssl rand -hex 32）
#   · CORS_ORIGINS 不能是 *，须指定前端域名（逗号分隔）
JWT_SECRET=your-jwt-secret-here
AUTH_REQUIRED=false
CORS_ORIGINS=*
DEMO_USER_EMAIL=admin@taxinsight.com
DEMO_USER_PASSWORD=admin123
