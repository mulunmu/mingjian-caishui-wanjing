# 复制为 .env；勿提交真实密钥
DATABASE_URL=postgresql+asyncpg://risk_user:risk_pass@localhost:5432/risk_db

LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com
LLM_FALLBACK_MODEL=deepseek-v4-flash
LLM_DIALOGUE_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=15
RAG_HYBRID_ENABLED=true
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_CACHE_DIR=/app/.fastembed_cache
RAG_EMBEDDING_DIM=512
RAG_EMBEDDINGS_AUTO_SEED=true
MEMORY_SEMANTIC_ENABLED=true
LANGGRAPH_FINANCE_REVIEW_ENABLED=false
LANGGRAPH_FINAL_GUARD_ENABLED=true
LANGGRAPH_AGENT_BUDGET_MS=15000
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
LLM_DAILY_LIMIT=1000

# M1 通义点金金融解读层（可选，不配则回退到主 LLM）
FINANCIAL_LLM_MODEL=
FINANCIAL_LLM_API_KEY=
FINANCIAL_LLM_BASE_URL=

# Shadow semantic evaluation; keep false in production until staging gates pass
SHADOW_SEMANTIC_ENABLED=false
SHADOW_SEMANTIC_INDEPENDENT_ROUTE=true
SHADOW_ANSWER_EVAL_ENABLED=false
SEMANTIC_CANARY_PERCENT=0
SEMANTIC_PRIMARY_ENABLED=false
SEMANTIC_PRIMARY_PERCENT=0
SEMANTIC_PLANNER_ENABLED=true
SEMANTIC_PLANNER_PERCENT=100
SEMANTIC_PLAN_LANGGRAPH_NODE_ENABLED=true
SEMANTIC_REPORT_PLAN_ENABLED=true
SEMANTIC_TOPIC_RESOLVER_ENABLED=true
SEMANTIC_LEGACY_ROUTE_FALLBACK=true
INSTALL_ORCHESTRATION=true
LANGGRAPH_OUTER_ENABLED=true
LANGGRAPH_REPORT_APPROVAL_REQUIRED=true
REPORT_BLOCK_TREE_ENABLED=true

JWT_SECRET=your-jwt-secret-here-at-least-32-chars
AUTH_REQUIRED=true
ALLOW_SELF_REGISTER=false
DEMO_LOGIN_ENABLED=false
CORS_ORIGINS=http://localhost:3000
DEMO_USER_EMAIL=admin@example.com
DEMO_USER_PASSWORD=change-me-now

# 邮箱验证码（注册）：开启前必须先配好 EMAIL_*
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_SENDER=your-account@qq.com
EMAIL_PASSWORD=your-smtp-auth-code
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
VERIFY_CODE_TTL_REGISTER=900
VERIFY_CODE_TTL_LOGIN=600
VERIFY_RESEND_COOLDOWN=60
VERIFY_MAX_ATTEMPTS=5
VERIFY_SEND_WINDOW_SECONDS=900
VERIFY_SEND_LIMIT_PER_EMAIL=5
VERIFY_SEND_LIMIT_PER_IP=20
VERIFY_ATTEMPT_WINDOW_SECONDS=900
