# 复制为 .env；勿提交真实密钥
DATABASE_URL=postgresql+asyncpg://risk_user:risk_pass@localhost:5432/risk_db

LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com
LLM_FALLBACK_MODEL=deepseek-v4-flash
LLM_DAILY_LIMIT=1000

JWT_SECRET=your-jwt-secret-here-at-least-32-chars
AUTH_REQUIRED=true
ALLOW_SELF_REGISTER=false
DEMO_LOGIN_ENABLED=false
CORS_ORIGINS=http://localhost:3000
DEMO_USER_EMAIL=admin@example.com
DEMO_USER_PASSWORD=change-me-now

# 邮箱验证码（注册）：开启前必须先配好 EMAIL_*
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_SENDER=your-account@qq.com
EMAIL_PASSWORD=your-smtp-auth-code
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
VERIFY_CODE_TTL=300
VERIFY_RESEND_COOLDOWN=60
VERIFY_MAX_ATTEMPTS=5
VERIFY_DAILY_LIMIT_PER_EMAIL=10
VERIFY_DAILY_LIMIT_PER_IP=30
