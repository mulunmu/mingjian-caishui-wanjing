# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，不会被提交。
#
# ⚠️ 安全：仓库曾泄露一枚真实 DeepSeek key，已全仓脱敏。请重新生成新 key 填入 LLM_API_KEY。
DATABASE_URL=postgresql+asyncpg://risk_user:risk_pass@localhost:5432/risk_db

# ── LLM ──
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com
LLM_FALLBACK_MODEL=deepseek-v4-flash
LLM_DAILY_LIMIT=1000

# ── 认证（上线前必须开启 AUTH_REQUIRED=true）──
# JWT_SECRET 至少 32 字符随机值（openssl rand -hex 32）
JWT_SECRET=your-jwt-secret-here
AUTH_REQUIRED=false
DEMO_USER_EMAIL=admin@taxinsight.com
DEMO_USER_PASSWORD=admin123
